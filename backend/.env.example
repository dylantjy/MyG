# Copy to backend/.env. Everything here is optional.

# AI: by default the backend uses a free local model through Ollama (ollama pull gemma3:4b).
# To use OpenAI instead, set OPENAI_API_KEY (and optionally OPENAI_MODEL, default gpt-4o-mini).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gemma3:4b
# OPENAI_BASE_URL=http://localhost:11434/v1

# Database: leave unset to use a local MongoDB stored in backend/.data
# MONGODB_URI=

# Only for the (disabled) Google login route
# GOOGLE_CLIENT_ID=

PORT=3000
