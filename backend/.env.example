# Copy to backend/.env and fill in your own values

# Required for the AI coach, workout suggestions, muscle tiers and food scanner
OPENAI_API_KEY=sk-...
# Optional: any OpenAI model that supports JSON mode and image input
OPENAI_MODEL=gpt-4o-mini

# Optional: leave unset to use a local MongoDB stored in backend/.data
MONGODB_URI=

# Optional: only for the (disabled) Google login route
GOOGLE_CLIENT_ID=

PORT=3000
